# ---------------------------------------------------------------------------
# LoyaltyLoop server configuration
# Copy to server/.env (or export in your process manager) before running.
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=4000

# Absolute or relative path to the SQLite database file.
DATABASE_PATH=./data/loyaltyloop.sqlite

# ---------------------------------------------------------------------------
# SECRETS — generate with: openssl rand -hex 48
# The server refuses to boot in production if these are missing or too short.
# Rotating ACCESS_TOKEN_SECRET invalidates every logged-in session.
# ---------------------------------------------------------------------------
ACCESS_TOKEN_SECRET=dev-only-access-secret-change-me-0123456789abcdef
REFRESH_TOKEN_SECRET=dev-only-refresh-secret-change-me-0123456789abcdef
QR_TOKEN_SECRET=dev-only-qr-secret-change-me-0123456789abcdef

ACCESS_TOKEN_TTL_MINUTES=30
REFRESH_TOKEN_TTL_DAYS=30

# Comma separated list of origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# Trial length granted to a new merchant on self-serve signup.
TRIAL_DAYS=14

# Bcrypt cost factor. 12 is a sane production default.
BCRYPT_ROUNDS=12
