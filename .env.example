# ---------------------------------------------------------------------------
# LoyaltyLoop server configuration
# Copy to server/.env (or export in your process manager) before running.
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=4000

# Absolute or relative path to the SQLite database file.
DATABASE_PATH=./data/loyaltyloop.sqlite

# ---------------------------------------------------------------------------
# SECRETS — generate with: openssl rand -hex 48
# The server refuses to boot in production if these are missing or too short.
# Rotating ACCESS_TOKEN_SECRET invalidates every logged-in session.
# ---------------------------------------------------------------------------
ACCESS_TOKEN_SECRET=dev-only-access-secret-change-me-0123456789abcdef
REFRESH_TOKEN_SECRET=dev-only-refresh-secret-change-me-0123456789abcdef
QR_TOKEN_SECRET=dev-only-qr-secret-change-me-0123456789abcdef

ACCESS_TOKEN_TTL_MINUTES=30
REFRESH_TOKEN_TTL_DAYS=30

# Comma separated list of origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175

# Trial length granted to a new merchant on self-serve signup.
TRIAL_DAYS=14

# Bcrypt cost factor. 12 is a sane production default.
BCRYPT_ROUNDS=12

# ---------------------------------------------------------------------------
# AI AGENT ISLAND — multi-agent mission orchestration
#
# With no key set the island still runs end to end, but on the *simulation*
# engine: it exercises the real orchestrator, the real schemas and the real
# verification loop while fabricating nothing. Simulated missions are labelled
# as such everywhere, including in the final report, because a report that
# looks like research but is not would be worse than no report at all.
#
# Set a key to run missions on Claude with live web search.
# ---------------------------------------------------------------------------

# Either name works — ANTHROPIC_API_KEY is read first, ANTHROPIC_AUTH_TOKEN is
# the fallback for environments that already inject a credential under that name.
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_AUTH_TOKEN=

ISLAND_ENABLED=true
ISLAND_MODEL=claude-opus-5

# Web searches one research agent may make in a single mission.
ISLAND_MAX_WEB_SEARCHES=6

# Schema-repair round trips before an agent's answer is rejected.
ISLAND_MAX_REPAIRS=2

# Attempts per agent before falling back or marking it failed.
ISLAND_MAX_ATTEMPTS=2

# Verification loop: how many times work may be sent back for correction
# before its issues are recorded as unresolved and carried into the report.
ISLAND_MAX_CORRECTION_ROUNDS=3

# Agents run in parallel wherever the dependency graph allows it. This caps
# how many model calls are in flight at once.
ISLAND_MAX_CONCURRENCY=3

ISLAND_AGENT_TIMEOUT_MS=240000

# A mission costs real tokens, so it is rate limited per merchant per day.
ISLAND_MISSIONS_PER_DAY=25

# ---------------------------------------------------------------------------
# MARKET DATA — the price feed behind the forex desk
#
# Leaving MARKET_DATA_API_KEY unset is a supported configuration, not a broken
# one. With no key nothing is fetched, no market_data reaches an agent's
# envelope, and the Technical Analysis Agent says plainly that it was given no
# prices — rather than producing a level from memory. A missing feed is
# reported as a missing feed.
#
# With a key set, prices are fetched for missions that name a currency pair,
# attached to the technical agent alone, and recorded in the mission's source
# register with provider and timestamp like any other piece of evidence.
# ---------------------------------------------------------------------------

# Which adapter serves prices. Twelve Data's free tier covers forex.
MARKET_DATA_PROVIDER=twelvedata

# Unset means no feed; see above. A fetch that fails is also no feed — it is
# reported as a failed fetch, never filled in from somewhere else.
# MARKET_DATA_API_KEY=

# Candle interval, in the provider's own vocabulary (e.g. 1day, 4h, 1h).
MARKET_DATA_INTERVAL=1day

# Candles per request: enough history to read structure, few enough that a
# free-tier response stays small.
MARKET_DATA_CANDLES=120

# --- Research connectors -----------------------------------------------------
# Named public pages the Research Agent actually retrieves, rather than sources
# a model says exist. They run only when a real engine is configured: under the
# simulation engine nothing is fetched, because a mission whose findings are
# placeholders must not carry freshly retrieved sources beside them.
#
# The shipped list is Maldives statistics (tourism, bureau of statistics, MMA).
# Point a deployment serving another market somewhere else with a JSON array of
# {id, title, url, sourceType, reliability, tokenEnv?, tokenUrl?}:
# RESEARCH_CONNECTORS=[{"id":"x","title":"X","url":"https://…","sourceType":"official_release","reliability":"high"}]
# RESEARCH_TIMEOUT_MS=9000
# RESEARCH_MAX_CHARS=18000

# The MMA statistics API needs a token. Without one that connector reports
# auth_required and names the registration page, rather than being quietly
# dropped or faked. Request one at https://database.mma.gov.mv/api/register
# MMA_STATISTICS_API_TOKEN=
